@startuml unit_design

title message_passing - ClientConnection / Engine / Server / Factory relationships (QNX Dispatch)

skinparam classAttributeIconSize 0
hide empty members

namespace score.message_passing {

    ' ---- Core interfaces ---------------------------------------------------
    interface IClientConnection
    interface ISharedResourceEngine
    interface IServer
    interface IClientFactory
    interface IServerFactory

    ' ---- Platform-agnostic implementation (score::message_passing::detail) --
    namespace detail {
        class ClientConnection
        class QnxDispatchServer
    }

    ' ---- QNX Dispatch implementation ---------------------------------------
    namespace qnx_dispatch {
        class QnxDispatchEngine {
            +class ResourceManagerServer
            +class ResourceManagerConnection
        }
        class QnxDispatchClientFactory
        class QnxDispatchServerFactory
    }
}

' =================== Realization (interface -> implementation) =================
score.message_passing.IClientConnection <|.. score.message_passing.detail.ClientConnection

score.message_passing.ISharedResourceEngine <|.. score.message_passing.qnx_dispatch.QnxDispatchEngine

score.message_passing.IServer <|.. score.message_passing.detail.QnxDispatchServer

score.message_passing.IClientFactory <|.. score.message_passing.qnx_dispatch.QnxDispatchClientFactory

score.message_passing.IServerFactory <|.. score.message_passing.qnx_dispatch.QnxDispatchServerFactory

' =================== Private inheritance (QNX-specific engine coupling) ========
score.message_passing.detail.QnxDispatchServer --|> score.message_passing.qnx_dispatch.QnxDispatchEngine : "ResourceManagerServer\n(private base)"

' =================== Containment / composition (holds via shared_ptr) ==========
score.message_passing.detail.ClientConnection o--> score.message_passing.ISharedResourceEngine : engine_

score.message_passing.qnx_dispatch.QnxDispatchClientFactory o--> score.message_passing.qnx_dispatch.QnxDispatchEngine : engine_
score.message_passing.qnx_dispatch.QnxDispatchServerFactory o--> score.message_passing.qnx_dispatch.QnxDispatchEngine : engine_

' =================== Dependency: uses a nested config type from a factory ======
score.message_passing.detail.ClientConnection ..> score.message_passing.IClientFactory : uses\nIClientFactory::ClientConfig
score.message_passing.detail.QnxDispatchServer ..> score.message_passing.IServerFactory : uses\nIServerFactory::ServerConfig

' =================== Dependency: factory creates connection/server instance ====
score.message_passing.qnx_dispatch.QnxDispatchClientFactory ..> score.message_passing.detail.ClientConnection : "Create()\ncreates"

score.message_passing.qnx_dispatch.QnxDispatchServerFactory ..> score.message_passing.detail.QnxDispatchServer : "Create()\ncreates"

note bottom of score.message_passing
  Legend:
  <b><|..</b>  realizes / implements interface
  <b>--|></b>  inherits (private base, QNX resource-manager coupling)
  <b>o--></b>  holds / composes (stored as shared_ptr member)
  <b>..></b>   dependency (uses a type from / is created by)
end note

@enduml
